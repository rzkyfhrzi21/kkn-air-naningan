# ============================================================
#  CONTOH KONFIGURASI — PEKON AIR NANINGAN
#  Salin file ini menjadi `.env` lalu isi nilainya.
#  .env tidak di-commit; file ini boleh di-commit sebagai referensi.
# ============================================================

# --- Identitas situs ---
APP_NAME="Website Pekon Airnaningan"
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# --- Kontak & media sosial ---
KONTAK_ALAMAT="Balai Pekon Air Naningan, Kecamatan Air Naningan, Kabupaten Tanggamus"
KONTAK_WHATSAPP=08xxxxxxxxxx
KONTAK_INSTAGRAM_HANDLE=@username
KONTAK_INSTAGRAM_URL=https://www.instagram.com/username

# --- Jam operasional pelayanan (per hari) ---
JAM_SENIN="08.00-14.00"
JAM_SELASA="08.00-14.00"
JAM_RABU="08.00-14.00"
JAM_KAMIS="08.00-14.00"
JAM_JUMAT="08.00-14.00"
JAM_SABTU="Tutup"
JAM_MINGGU="Tutup"

# --- Peta (URL embed Google Maps; ambil dari Bagikan > Sematkan peta) ---
MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."

# --- Anggota Kelompok KKN (JSON array) ---
KKN_ANGGOTA=[]
